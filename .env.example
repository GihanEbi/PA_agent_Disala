
# Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret for the Clerk webhook endpoint (app/api/webhooks/clerk/route.ts)
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI (used by the Disala agent — app/api/chat/route.ts)
OPENAI_API_KEY=

# Supabase Postgres (via Prisma)
# Transaction pooler (port 6543) — runtime queries
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — migrations only
DIRECT_URL="postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres"

# WhatsApp read-only integration (experimental, unofficial — see
# prompts/disala-17-whatsapp-readonly-integration.md). Required by both the
# Next.js app and `npm run whatsapp:worker`.
# 32-byte AES-256 key, base64-encoded. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_SESSION_ENCRYPTION_KEY=
# Localhost port the worker's control server listens on (default 4178).
WHATSAPP_WORKER_PORT=4178
# How long cached WhatsApp messages are kept before being pruned (default 30).
WHATSAPP_MESSAGE_RETENTION_DAYS=30
