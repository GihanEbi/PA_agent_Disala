generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum ConnectedAccountProvider {
  GOOGLE
}

enum ConnectedAccountStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
  ERROR
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum ApprovalActionType {
  EMAIL_SEND
  CALENDAR_CREATE
  CALENDAR_UPDATE
  CALENDAR_CANCEL
  NOTE_CREATE
  NOTE_UPDATE
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

enum ReminderStatus {
  PENDING
  COMPLETED
  DISMISSED
}

enum CreationSource {
  USER
  ASSISTANT
}

enum SuggestionStatus {
  ACTIVE
  ACCEPTED
  DISMISSED
}

enum ContactSource {
  MANUAL
  BUSINESS_CARD
}

enum WhatsAppConnectionStatus {
  PENDING_QR
  CONNECTED
  DISCONNECTED
  ERROR
}

// --- Models ---

model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  name        String?
  email       String   @unique
  timezone    String   @default("UTC")
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connectedAccounts   ConnectedAccount[]
  conversations       Conversation[]
  approvals           Approval[]
  reminders           Reminder[]
  suggestions         Suggestion[]
  notes               Note[]
  contacts            Contact[]
  contactAliases      ContactAlias[]
  whatsAppConnection  WhatsAppConnection?
  whatsAppSyncedChats WhatsAppSyncedChat[]
  whatsAppMessages    WhatsAppMessage[]

  @@map("users")
}

model ConnectedAccount {
  id                String                   @id @default(cuid())
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          ConnectedAccountProvider
  providerAccountId String
  // Connection is a synced read-model of Clerk's external account state —
  // Clerk itself holds and refreshes the real Google access/refresh tokens,
  // which never touch our database. See prompts/disala-04-google-connected-accounts.md.
  providerEmail     String?
  scopes            String[]
  status            ConnectedAccountStatus   @default(ACTIVE)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([userId, provider, providerAccountId])
  @@map("connected_accounts")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  approvals Approval[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  toolCalls      Json?
  createdAt      DateTime     @default(now())

  @@map("messages")
}

model Approval {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  actionType     ApprovalActionType
  title          String
  description    String
  payload        Json
  status         ApprovalStatus     @default(PENDING)
  createdAt      DateTime           @default(now())
  expiresAt      DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  executedAt     DateTime?
  // What actually happened when this was executed — a Gmail message id, a
  // Calendar event id/link, or a structured error — recorded separately
  // from `payload`, which must stay the original unexecuted request.
  result         Json?

  @@map("approvals")
}

model Reminder {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  remindAt    DateTime
  status      ReminderStatus @default(PENDING)
  source      CreationSource @default(USER)
  createdAt   DateTime       @default(now())

  @@map("reminders")
}

model Note {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  source    CreationSource @default(USER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("notes")
}

model Suggestion {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  priority    Int              @default(0)
  source      String
  status      SuggestionStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())

  @@map("suggestions")
}

model Contact {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  company   String?
  title     String?
  email     String?
  phone     String?
  website   String?
  address   String?
  source    ContactSource @default(MANUAL)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  aliases ContactAlias[]

  @@index([userId])
  @@map("contacts")
}

// A name/nickname the agent has been told (once) resolves to this contact —
// written by the save_contact_alias tool after the user confirms an
// ambiguous or misheard name, so the same text resolves directly next time
// without asking again. `alias` is always stored trimmed + lowercased; see
// lib/contact-aliases.ts.
model ContactAlias {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  alias     String
  createdAt DateTime @default(now())

  @@unique([userId, alias])
  @@index([userId])
  @@index([contactId])
  @@map("contact_aliases")
}

// One linked WhatsApp companion-device session per user. `sessionState` holds
// Baileys' AuthenticationState (creds + signal keys), AES-256-GCM-encrypted
// by lib/crypto/encryption.ts before it ever reaches this column — this is
// the credential itself (full read access to the linked account), not a
// read-model of one Clerk already holds, unlike ConnectedAccount. Only ever
// read/written by worker/ code, never by app/ route handlers directly. See
// prompts/disala-17-whatsapp-readonly-integration.md.
model WhatsAppConnection {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber        String?
  status             WhatsAppConnectionStatus @default(PENDING_QR)
  sessionState       Json?
  riskAcknowledgedAt DateTime?
  connectedAt        DateTime?
  lastSeenAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  syncedChats WhatsAppSyncedChat[]

  @@map("whatsapp_connections")
}

// A 1:1 WhatsApp chat the user has explicitly opted into syncing. Group
// chats (JIDs ending "@g.us") are never represented here — see disala-17
// decision #5. Only messages from a chat with `syncing: true` are ever
// written to WhatsAppMessage.
model WhatsAppSyncedChat {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  chatJid      String
  chatName     String?
  syncing      Boolean            @default(true)
  createdAt    DateTime           @default(now())

  @@unique([userId, chatJid])
  @@index([userId])
  @@map("whatsapp_synced_chats")
}

// A cached text message from an opted-in chat — the minimum needed to
// answer a question, not a mailbox export. Rows older than
// WHATSAPP_MESSAGE_RETENTION_DAYS are deleted by the worker's pruning pass
// (disala-17 decision #2). Media is never stored, only text.
model WhatsAppMessage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatJid     String
  // WhatsApp's own message id — Baileys can redeliver the same message
  // across a reconnect, so writes are upserts keyed on this, not blind
  // inserts (AGENTS.md §15's "avoid duplicate actions" applied to receiving).
  waMessageId String
  senderJid   String
  senderName  String?
  text        String
  isFromMe    Boolean  @default(false)
  sentAt      DateTime
  createdAt   DateTime @default(now())

  @@unique([userId, chatJid, waMessageId])
  @@index([userId, chatJid, sentAt])
  @@index([sentAt])
  @@map("whatsapp_messages")
}
